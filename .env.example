PORT=3000
NODE_ENV=development
ADMIN_PASSWORD=iitbhu11
SESSION_SECRET=replace-with-at-least-32-random-characters-please
DATA_DIR=./data

# Microsoft Entra app registration settings for Excel Online / OneDrive sync.
# Register a Web redirect URI exactly matching APP_BASE_URL + /api/onedrive/callback.
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_TENANT=common
APP_BASE_URL=http://localhost:3000
# Set to the exact GitHub Pages origin if frontend and API are hosted separately, e.g. https://username.github.io
FRONTEND_ORIGIN=
ONEDRIVE_WORKBOOK_NAME=athletics-website-data.xlsx
ONEDRIVE_POLL_MS=60000

# Google Sheets two-way sync (set after deploying the bound Apps Script web app)
GOOGLE_SHEETS_WEBAPP_URL=
GOOGLE_SHEETS_TOKEN=
GOOGLE_SHEETS_POLL_MS=30000
